<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <EnableDefaultItems>false</EnableDefaultItems>
    <ProductRoot Condition="'$(ProductRoot)' == ''">$(MSBuildThisFileDirectory)../../..</ProductRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml.Linq" />
    <Compile Include="Probe.cs.txt" />
    <Compile Include="GridLoaders.cs.txt" />
    <Compile Include="$(ProductRoot)/ExtLibs/Utilities/ParameterDescriptions.cs" />
    <Compile Include="$(ProductRoot)/GCSViews/ConfigurationView/ConfigRawParams.ParameterDescriptions.cs" />
    <Compile Include="$(ProductRoot)/MissionPlannerTests/ParameterDescriptions/UiCompilationStubs.cs.txt" />
    <EmbeddedResource Include="$(ProductRoot)/localization/parameters/official-first-batch.xml"
                      LogicalName="MissionPlanner.Utilities.ParameterDescriptions.official.xml" WithCulture="false" />
    <EmbeddedResource Include="$(ProductRoot)/localization/parameters/zh-CN.xml"
                      LogicalName="MissionPlanner.Utilities.ParameterDescriptions.zh-CN.xml" WithCulture="false" />
  </ItemGroup>
</Project>
